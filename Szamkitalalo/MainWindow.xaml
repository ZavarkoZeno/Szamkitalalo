<Window x:Class="Szamkitalalo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Szamkitalalo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Label Content="Számkitaláló játék" FontSize="50" FontWeight="Bold" Margin="10" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBox x:Name="textBox" Width="200" Height="30" Margin="10"/>
            <Button Content="Tippelés" Width="100" Height="20" Margin="10" Click="tippeles"/>
            <ListBox x:Name="lista" Width="177" Height="90" Margin="10"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="Új játék" Width="100" Height="20" Margin="10" Click="ujjatek"/>
            <Button Content="Kilépés" Width="100" Height="20" Margin="10" Click="kilepes"/>
        </StackPanel>
    </Grid>
</Window>
